# ============================================================
# KyyPureStatus — Environment Variables
# Salin file ini menjadi .env lalu isi sesuai kebutuhan
# ============================================================

# Port server (Railway akan set otomatis)
PORT=3000

# Direktori data persistent (session Baileys, uploads, history, video)
# Di Railway: mount volume dan set DATA_DIR=/data (atau Railway set
# RAILWAY_VOLUME_MOUNT_PATH otomatis ke path volume)
DATA_DIR=./data

# Opsional: proteksi akses web. Jika diisi, aplikasi meminta "App Key"
# sebelum bisa dipakai (disarankan jika deploy publik).
APP_KEY=

# Batas ukuran upload video (MB)
MAX_UPLOAD_MB=100

# Batas ukuran output video setelah kompresi (MB) — menjaga agar
# video tetap bisa dikirim & di-forward ke Status tanpa gagal
MAX_OUTPUT_MB=50

# Mode uji (JANGAN aktifkan di produksi!)
# Jika true: koneksi WhatsApp di-simulasi supaya alur upload →
# kompres → kirim bisa dicoba tanpa nomor asli.
MOCK_SEND=false

# Path ffmpeg custom (opsional; default: ffmpeg-static lalu PATH)
FFMPEG_PATH=

# Preset encoder x264: veryfast | faster | medium | slow
# 'faster' = default (kualitas tinggi, cepat). 'slow' = kualitas maksimal tapi lama.
FFMPEG_PRESET=faster
